{
  "include": ["src", "tests"],
  "exclude": [
    "**/__pycache__",
    ".venv",
    "build",
    "dist",
    "docs",
    "references"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.12",
  "typeCheckingMode": "standard",
  "reportMissingImports": true,
  "reportMissingTypeStubs": false
}
